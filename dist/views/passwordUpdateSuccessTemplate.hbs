<div style="max-width: 600px; margin: 50px auto; background-color: #ffffff; padding: 40px; border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.06); font-family: 'Segoe UI', sans-serif; text-align: center;">

  <div style="background-color: #e0f2fe; border-radius: 50%; width: 90px; height: 90px; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px;">
    <img src="https://img.icons8.com/fluency/96/password-window.png" alt="Password Updated" style="width: 48px; height: 48px;" />
  </div>

  <h2 style="color: #0f172a; font-size: 24px; margin-bottom: 12px;">Password Updated Successfully</h2>

  <p style="font-size: 16px; color: #475569; line-height: 1.6; margin-bottom: 24px;">
    Hi <strong>{{userName}}</strong>,<br />
    We’re confirming that the password for your <strong>{{companyName}}</strong> account was successfully changed.
  </p>

  <p style="font-size: 14px; color: #64748b; line-height: 1.6;">
    If you did not authorize this change, please reset your password immediately and contact our support team to secure your account.
  </p>

  <a href="{{link}}" target="_blank" style="display: inline-block; margin-top: 30px; padding: 12px 30px; background-color: #1d4ed8; color: #ffffff; text-decoration: none; border-radius: 6px; font-weight: 600;">
    Contact Support
  </a>

  <p style="font-size: 14px; color: #94a3b8; margin-top: 30px;">
    — The <strong>{{companyName}}</strong> Team
  </p>

</div>
