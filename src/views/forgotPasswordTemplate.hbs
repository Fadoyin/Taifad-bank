<body style="margin: 0; padding: 0; font-family: 'Segoe UI', sans-serif; background-color: #f0f4f8;">

  <div style="max-width: 600px; margin: 50px auto; background-color: #ffffff; padding: 40px; border-radius: 12px; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.06); text-align: center;">

    <div style="background-color: #e0f2fe; border-radius: 50%; width: 90px; height: 90px; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px;">
      <img src="https://img.icons8.com/fluency/96/email-open.png" alt="Email Icon" style="width: 48px; height: 48px;" />
    </div>

    <h2 style="color: #0f172a; font-size: 24px; margin-bottom: 12px;">Your Verification Code</h2>

    <p style="font-size: 16px; color: #475569; line-height: 1.6; margin-bottom: 30px;">
      Hello <strong>{{userName}}</strong>,<br />
      Use the code below to verify your email and secure your account.
    </p>

    <div style="margin: 0 auto 30px; background-color: #f8fafc; display: inline-block; padding: 16px 36px; border-radius: 8px; font-size: 30px; font-weight: bold; letter-spacing: 2px; color: #1e293b; border: 1px dashed #cbd5e1;">
      {{verificationCode}}
    </div>

    <p style="font-size: 14px; color: #64748b; margin-top: 0;">
      This code is valid for the next <strong>10 minutes</strong>. If you didn’t request this, you can safely ignore this email.
    </p>

    <p style="font-size: 14px; color: #94a3b8; margin-top: 30px;">
      — The <strong>{{companyName}}</strong> Team
    </p>

  </div>
</body>
